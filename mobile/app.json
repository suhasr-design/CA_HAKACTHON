{
  "expo": {
    "name": "Fair Tickets",
    "slug": "fair-tickets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chiparchitects.fairtickets",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Fair Tickets uses the camera to scan the gate's code QR when you enter the venue.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "defaultHost": "192.168.8.97",
      "eas": {
        "projectId": "9b0947b0-3d9a-4018-9326-3a186d593903"
      }
    },
    "owner": "srujanc"
  }
}
